# Kopieren nach .env und anpassen: cp .env.example .env
# .env wird NICHT committet.

# Zeitzone für alle Container
TZ=Europe/Zurich

# Let's Encrypt (proxy/)
LETSENCRYPT_EMAIL=you@example.com

# OVH-API für automatische DNS-Nachführung bei IP-Wechsel (system/ovh-dns.py, system/ip-check.sh)
# und das Wildcard-Zertifikat *.homi.solar (proxy/wildcard-cert.sh). Token: https://eu.api.ovh.com/createToken/ – Rechte nur:
#   GET /domain/zone/biber.solar/record*   PUT /domain/zone/biber.solar/record*   POST /domain/zone/biber.solar/refresh
#   GET /domain/zone/homi.solar/record*    PUT /domain/zone/homi.solar/record*    POST /domain/zone/homi.solar/refresh
#   POST /domain/zone/homi.solar/record*   DELETE /domain/zone/homi.solar/record*   (TXT-Eintrag für DNS-01)
#   Achtung: das * am Ende von record* gehört dazu (ohne * sind die einzelnen Einträge gesperrt).
#   Nach einem Schlüsselwechsel: proxy/wildcard-cert.sh erneut aufrufen (schreibt proxy/certbot/conf/ovh.ini neu).
#   Gültigkeit: unbegrenzt, KEINE IP-Einschränkung (die IP ändert sich ja gerade dann)
OVH_ENDPOINT=https://eu.api.ovh.com/1.0
OVH_APPLICATION_KEY=<application-key>
OVH_APPLICATION_SECRET=<application-secret>
OVH_CONSUMER_KEY=<consumer-key>
