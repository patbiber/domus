# Dauerhafte Claude-Code-Session mit Remote Control (claude.ai/code bzw. Claude-App).
# Läuft in eigenem tmux-Server (-L claude-remote, unabhängig von anderen tmux-Sitzungen),
# lokal ansehbar mit: tmux -L claude-remote attach
[Unit]
Description=Claude Code Remote Control (domus)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
WorkingDirectory=%h/domus
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/tmux -L claude-remote new-session -d -s claude-remote 'claude remote-control --name domus --permission-mode default --spawn same-dir'
ExecStop=/usr/bin/tmux -L claude-remote kill-server
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
