# Dauerhafte Claude-Code-Session mit Remote Control (claude.ai/code bzw. Claude-App).
# Läuft in tmux, lokal ansehbar mit: tmux attach -t claude-remote
[Unit]
Description=Claude Code Remote Control (domus)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
WorkingDirectory=%h/domus
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/tmux new-session -d -s claude-remote 'claude remote-control --name domus --permission-mode default --spawn same-dir'
ExecStop=/usr/bin/tmux kill-session -t claude-remote
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
